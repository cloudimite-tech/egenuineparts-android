DATABASE_URL=postgres://postgres:postgres@localhost:5433/redline_parts
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# USD→LKR is fetched live every 6h. Uncomment only to FORCE a fixed rate:
# USD_TO_LKR=330

# --- Production (Vercel) only ---
# DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require   (pooled string)
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store
# DB_POOL_MAX=1

# --- Product sharing (optional) ---
# Where the share page's "Get the app" button points (APK link now, Play Store later)
# APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=lk.genuineparts.app
# SHA-256 fingerprint(s) of the APK signing certificate, comma-separated — turns on
# Android App Links so https://…/p/<id> opens the app directly (see README)
# ANDROID_CERT_SHA256=AB:CD:...
# Extra hosts whose /p/ and /s/ links are allowed in chat (your custom domain etc.)
# SHARE_HOSTS=genuineparts.lk
