{
  "expo": {
    "name": "AutoGuide",
    "slug": "autoguide",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.autoguide.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "lk.autoguide.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "autoguide",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoGuide needs access to your photos so you can add pictures of parts and your verification documents.",
          "cameraPermission": "AutoGuide needs the camera so you can photograph parts, your documents and a selfie at your shop."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AutoGuide uses your location to pin your shop on the map and to verify your shop selfie."
        }
      ],
      "./plugins/withProjectJdk",
      "./plugins/withReleaseSigning"
    ]
  }
}
